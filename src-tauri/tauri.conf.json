{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Renovador de Livros",
  "version": "2.0.0-alpha.0",
  "identifier": "br.edu.uftm.editora.renovador",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../build"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "Renovador de Livros",
        "width": 1100,
        "height": 760,
        "minWidth": 360,
        "minHeight": 560
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; font-src 'self'; connect-src ipc: http://ipc.localhost; script-src 'self'; object-src 'none'; base-uri 'none'; frame-ancestors 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Utility",
    "shortDescription": "Renovação automática e responsável de empréstimos da biblioteca",
    "licenseFile": "../LICENSE-MIT",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "windows": { "nsis": { "languages": ["PortugueseBR"], "installMode": "currentUser" } }
  }
}
